# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Optional. Without Stripe, customers can use cash on delivery.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Optional contact button destination (public inbox only).
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional password recovery email (Resend). Without these, recovery stays safely disabled.
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="HomeFoods <accounts@example.com>"
# Public base URL used to construct password-reset links.
APP_URL="http://localhost:3000"

# Geoapify Geocoding and Routing APIs; server-side only (never use NEXT_PUBLIC_ prefix).
GEOAPIFY_API_KEY=""

# Fictional marketplace fixtures. Keep disabled outside an isolated development database.
HOMEFOODS_ENABLE_TEST_SEED="false"
HOMEFOODS_ENABLE_TEST_DATA="false"
HOMEFOODS_NATIONWIDE_TESTING="false"
ENFORCE_DELIVERY_RADIUS="true"
HOMEFOODS_SANDBOX_PAYMENTS="false"
HOMEFOODS_SANDBOX_NOTIFICATIONS="false"
# Set only after verifying that the remote URL points to a dedicated development database.
HOMEFOODS_ALLOW_REMOTE_TEST_SEED="false"
HOMEFOODS_ALLOW_REMOTE_NATIONWIDE_TESTING="false"
# Private development catalog only: include existing non-fixture seller kitchens.
HOMEFOODS_INCLUDE_EXISTING_SELLERS_IN_DEVELOPMENT="false"
